{
  "name": "@flowsync/github-action",
  "version": "0.1.0",
  "description": "GitHub Action that syncs release/PR data into Notion via FlowSync.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -b",
    "bundle": "ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^6.0.0",
    "@flowsync/core": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@vercel/ncc": "^0.38.1",
    "typescript": "^5.4.5"
  }
}
