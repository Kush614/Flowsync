# Notion integration token (https://www.notion.so/profile/integrations)
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Database IDs (32-char UUIDs without dashes from the Notion DB URL)
NOTION_CHANGELOG_DB_ID=
NOTION_API_REFERENCE_DB_ID=
NOTION_DATA_DICTIONARY_DB_ID=

# Optional: GitHub PAT for local CLI runs that hit the GitHub API
GITHUB_TOKEN=

# Parent Notion page for `notion-sync arch push` (the page the Architecture child is created under)
NOTION_ARCH_PARENT_PAGE_ID=
